    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/folders",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve a list of content folders in the SAP Analytics Cloud tenant."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Get a folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
