          "docs": "Retrieve details and execution history of a specific process chain."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Start a process chain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSPC_API_SRV/ProcessChains(':chainId')/Start",
            "params": [
              {
                "name": "chainId",
                "value": "",
