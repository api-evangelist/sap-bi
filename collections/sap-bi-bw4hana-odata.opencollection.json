{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Business Intelligence SAP BW/4HANA OData API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "InfoProviders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List InfoProviders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_INFOPROV_SRV/InfoProviders",
            "params": [
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (OData)"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination (OData)"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to return"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve a list of all InfoProviders (InfoCubes, DataStore Objects, CompositeProviders) available in the BW/4HANA system."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Get an InfoProvider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_INFOPROV_SRV/InfoProviders(':infoProviderName')",
            "params": [
              {
                "name": "infoProviderName",
                "value": "",
                "type": "path",
                "description": "InfoProvider technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve details and metadata of a specific InfoProvider."
        },
        {
          "info": {
            "name": "SAP Business Intelligence List InfoProvider dimensions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_INFOPROV_SRV/InfoProviders(':infoProviderName')/Dimensions",
            "params": [
              {
                "name": "infoProviderName",
                "value": "",
                "type": "path",
                "description": "InfoProvider technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve all dimensions associated with a specific InfoProvider."
        },
        {
          "info": {
            "name": "SAP Business Intelligence List InfoProvider key figures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_INFOPROV_SRV/InfoProviders(':infoProviderName')/KeyFigures",
            "params": [
              {
                "name": "infoProviderName",
                "value": "",
                "type": "path",
                "description": "InfoProvider technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve all key figures (measures) associated with a specific InfoProvider."
        }
      ]
    },
    {
      "info": {
        "name": "Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List BW queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_BW_QUERY_SRV/Queries",
            "params": [
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (OData)"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination (OData)"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve a list of all BW queries available in the system."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Get a BW query",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_BW_QUERY_SRV/Queries(':queryName')",
            "params": [
              {
                "name": "queryName",
                "value": "",
                "type": "path",
                "description": "BW query technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve metadata of a specific BW query."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Execute a BW query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_BW_QUERY_SRV/Queries(':queryName')/Execute",
            "params": [
              {
                "name": "queryName",
                "value": "",
                "type": "path",
                "description": "BW query technical name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a BW query with optional variable values and retrieve the result set."
        }
      ]
    },
    {
      "info": {
        "name": "Data Store Objects",
