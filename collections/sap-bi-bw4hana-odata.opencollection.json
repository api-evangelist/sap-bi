          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSOD_ADSO_SRV/DataStoreObjects(':adsoName')",
            "params": [
              {
                "name": "adsoName",
                "value": "",
                "type": "path",
                "description": "Advanced data store object technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve details and metadata of a specific advanced data store object."
        }
      ]
    },
    {
      "info": {
        "name": "Process Chains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List process chains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}:{port}/sap/opu/odata/sap/RSPC_API_SRV/ProcessChains",
            "params": [
