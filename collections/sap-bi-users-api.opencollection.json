{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Business Intelligence SAP Analytics Cloud Catalog Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.sapanalytics.cloud/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/users",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve a list of all users in the SAP Analytics Cloud tenant."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "User unique identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific user."
        }
      ]
    }
  ],
  "bundled": true
}