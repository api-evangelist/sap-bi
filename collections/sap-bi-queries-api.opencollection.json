{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Business Intelligence SAP Analytics Cloud Catalog Queries API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.sapanalytics.cloud/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Business Intelligence List BW queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/RSOD_BW_QUERY_SRV/Queries",
            "params": [
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (OData)"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination (OData)"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve a list of all BW queries available in the system."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Get a BW query",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/RSOD_BW_QUERY_SRV/Queries(':queryName')",
            "params": [
              {
                "name": "queryName",
                "value": "",
                "type": "path",
                "description": "BW query technical name"
              },
              {
                "name": "$format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Retrieve metadata of a specific BW query."
        },
        {
          "info": {
            "name": "SAP Business Intelligence Execute a BW query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.sapanalytics.cloud/api/v1/RSOD_BW_QUERY_SRV/Queries(':queryName')/Execute",
            "params": [
              {
                "name": "queryName",
                "value": "",
                "type": "path",
                "description": "BW query technical name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a BW query with optional variable values and retrieve the result set."
        }
      ]
    }
  ],
  "bundled": true
}