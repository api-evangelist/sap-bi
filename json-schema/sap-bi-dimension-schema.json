{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Dimension",
  "title": "Dimension",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Dimension unique identifier"
    },
    "name": {
      "type": "string",
      "description": "Dimension name"
    },
    "description": {
      "type": "string",
      "description": "Dimension description"
    },
    "type": {
      "type": "string",
      "enum": [
        "Generic",
        "Account",
        "Date",
        "Organization",
        "Version"
      ],
      "description": "Dimension type"
    }
  }
}